const W = 2
range Workers = 0..W-1
range Count   = 0..W

// 1. Processo Worker (usa azioni con suffisso [id])
WORKER(ID=0) = (
    compute_forces[ID] -> b1_enter[ID] -> b1_exit[ID] ->
    update_pos[ID]     -> b2_enter[ID] -> b2_exit[ID] ->
    WORKER(ID)
)-

// 2. Monitor Barriera riutilizzabile
BARRIER = ARRIVING[0],

ARRIVING[c:Count] = (
    when (c < W)  enter[w:Workers] -> ARRIVING[c+1]
  | when (c == W) exit[w:Workers]  -> LEAVING[W-1]
),

LEAVING[c:Count] = (
    when (c > 0)  exit[w:Workers]  -> LEAVING[c-1]
  | when (c == 0) enter[w:Workers] -> ARRIVING[1]
).

// 3. Composizione parallela con relabelling per distinguere b1 e b2
||N_BODY_SYSTEM = (
    forall [w:Workers] WORKER(w)
    || b1:BARRIER /{ b1_enter/b1.enter, b1_exit/b1.exit }
    || b2:BARRIER /{ b2_enter/b2.enter, b2_exit/b2.exit }
).

// ==========================================
// 4. PROPRIETÀ FLTL (Safety & Liveness)
// ==========================================

fluent COMPUTING[w:Workers] = <compute_forces[w], b1_enter[w]>
fluent UPDATING[w:Workers]  = <update_pos[w], b2_enter[w]>

// SAFETY: Nessun worker aggiorna le posizioni mentre un altro sta ancora calcolando le forze
assert NO_PHASE_OVERLAP = [] !(
    exists [w1:Workers] exists [w2:Workers] (COMPUTING[w1] && UPDATING[w2])
)

// LIVENESS: Ogni worker che inizia a calcolare le forze prima o poi completa l'aggiornamento posizioni
assert STEP_PROGRESS = forall [w:Workers]
    [] (compute_forces[w] -> <> update_pos[w])