const W = 2          // Numero di worker thread (astrazione per model checking)
range Workers = 0..W-1
range Count   = 0..W

// 1. Processo Worker: esegue le due fasi sincronizzandosi sulle barriere
WORKER = (
    compute_forces -> b1.enter -> b1.exit ->
    update_pos     -> b2.enter -> b2.exit ->
    WORKER
).

// 2. Monitor Barriera riutilizzabile (Cyclic Barrier)
BARRIER = ARRIVING[0],

// Fase di arrivo: i worker entrano e si sospendono finché non arrivano tutti (c == W)
ARRIVING[c:Count] = (
    when (c < W)  [w:Workers].enter -> ARRIVING[c+1]
  | when (c == W) [w:Workers].exit  -> LEAVING[W-1]
),

// Fase di rilascio: tutti i W worker escono prima di riutilizzare la barriera
LEAVING[c:Count] = (
    when (c > 0)  [w:Workers].exit  -> LEAVING[c-1]
  | when (c == 0) [w:Workers].enter -> ARRIVING[1]
).

// 3. Composizione parallela del sistema
||N_BODY_SYSTEM = (
    forall [w:Workers] [w]:WORKER
    || b1:BARRIER
    || b2:BARRIER
).

// ==========================================
// 4. PROPRIETÀ FLTL (Safety & Liveness)
// ==========================================

// Fluenti per tracciare la fase in cui si trova ciascun worker
fluent COMPUTING[w:Workers] = <[w].compute_forces, [w].b1.enter>
fluent UPDATING[w:Workers]  = <[w].update_pos, [w].b2.enter>

// SAFETY: Nessun worker può aggiornare le posizioni mentre un altro sta ancora calcolando le forze
assert NO_PHASE_OVERLAP = [] !(
    exists [w1:Workers] exists [w2:Workers] (COMPUTING[w1] && UPDATING[w2])
)

// LIVENESS: Se un worker inizia il calcolo delle forze, prima o poi completerà lo step (update_pos)
assert STEP_PROGRESS = forall [w:Workers]
    [] ([w].compute_forces -> <> [w].update_pos)